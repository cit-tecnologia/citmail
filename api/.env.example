# Copie para .env (ignorado pelo Git) e preencha. Nunca versione senhas.
# Senha do PostgreSQL de desenvolvimento (serviço "banco" do compose.yaml).
POSTGRES_PASSWORD=
# Mesma senha do POSTGRES_PASSWORD: postgres://postgres:<senha>@127.0.0.1:55432/citmail
DATABASE_URL=
HOST=127.0.0.1
PORT=3000
# Lista exata de origens separadas por vírgula; "*" não é aceito.
CORS_ORIGENS=http://127.0.0.1:4200
LOG_LEVEL=info
NODE_ENV=development
REDIS_URL=
FILA_PREFIXO=
FILA_TENTATIVAS=
FILA_BACKOFF_MS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
